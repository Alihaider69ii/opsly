DATABASE_URL=postgresql+psycopg://bizflow:bizflow@localhost:5432/bizflow
# development | test | staging | production (production enforces the startup safety gate)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# REQUIRED (32+ chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
SHOPIFY_OAUTH_RATE_LIMIT=20

REDIS_URL=redis://localhost:6379/0

# Production: which proxy addresses uvicorn trusts for X-Forwarded-For (never "*"); see ../docs/production.md
# FORWARDED_ALLOW_IPS=
# Optional hardening knobs (defaults are safe): API_DOCS_ENABLED, MAX_REQUEST_BODY_BYTES, DB_*_TIMEOUT_SECONDS,
# REDIS_QUEUE_KEY, SHOPIFY_WEBHOOKS_DISABLED, SHOPIFY_WEBHOOK_AUDIT_INTERVAL_SECONDS: see ../.env.example

# --- AI providers (vendor-neutral; full annotated list in ../.env.example, ../docs/ai-providers.md) ---
# openai, openrouter, groq, together, deepseek, mistral, gemini, custom_openai_compatible,
# or fake (offline, non-semantic, development only; refused in production). Blank model = default.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Legacy fallback for the "openai" provider only
OPENAI_API_KEY=

# Crawler limits are optional; see ../.env.example and ../docs/knowledge-base.md

# --- AI brain (Phase 3); full annotated list in ../.env.example and ../docs/ai-brain.md ---
LLM_PROVIDER=fake
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
CHAT_HISTORY_LIMIT=10
PUBLIC_CHAT_RATE_LIMIT=20
# memory (per process) or redis (shared across API workers)
RATE_LIMIT_BACKEND=memory

# --- Secrets at rest and Shopify (Phase 4); see ../.env.example and ../docs/shopify.md ---
# Generate: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:3000/integrations/shopify/callback
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=read_products,read_customers,read_orders
# Public https URL of this API for webhook registration (blank on localhost)
SHOPIFY_WEBHOOK_BASE_URL=

# --- WhatsApp (Phase 6-9), Email (Phase 9-10), platform admin (Phase 10) ---
# Blank = that integration shows "not configured" and nothing breaks. Full annotated list in
# ../.env.example, ../docs/whatsapp.md, ../docs/platform-admin.md.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
EMAIL_PROVIDER=fake
EMAIL_API_KEY=
EMAIL_WEBHOOK_SECRET=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

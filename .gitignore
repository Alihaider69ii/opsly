# OS / editors
.DS_Store
Thumbs.db
.idea/

# Internal planning/prompt notes dropped in .vscode/ (settings.json itself stays tracked)
.vscode/*.md

# Root-level phase prompt/history files -- development scratch, not part of the shipped repo.
# Listed individually by design (not a phase*.md pattern) so a future legitimate root doc isn't
# accidentally swept up.
/phase8.1.md
/phase8_prompt.md
/phase9.md
/phase_10prompt.md

# Key material and anything that can hold customer data must never be committed
*.pem
*.key
*.p12
*.pfx
secrets/
*.sqlite
*.sqlite3
*.db
# Output of `python -m tools.customer_data_export` (personal data of one customer)
request-*.json
# Browser-test artefacts (screenshots, traces, logs of real runs)
e2e/artifacts/
e2e/.env
.coverage
htmlcov/

# Mutation-testing output
backend/mutation/results.json

# Values for docker-compose.production.yml (docs/production.md). Copy to .env.production, which is
# git-ignored. Never commit real values. Generate every secret; use URL-safe characters only
# (the passwords end up inside connection URLs):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- public addresses (https, no trailing slash, no path) ---
APP_ORIGIN=
API_ORIGIN=

# --- secrets (all required) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 48+ random characters; signs login tokens
JWT_SECRET_KEY=
# Required only if you connect Shopify. 32 random bytes, base64:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=

# --- AI providers: a real vendor (production refuses the fake provider) ---
# openai | openrouter | groq | together | deepseek | mistral | gemini | anthropic | custom_openai_compatible
# Embeddings need a 1536-wide model: see docs/ai-providers.md for who can serve them.
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# --- Shopify (leave blank to run without it) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# true = run without live updates instead of exposing a public webhook URL (API_ORIGIN is used otherwise)
SHOPIFY_WEBHOOKS_DISABLED=false

# --- optional ---
# FORWARDED_ALLOW_IPS=172.28.0.0/24
# LOG_LEVEL=INFO

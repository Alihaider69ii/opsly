# Values for docker-compose.production.yml (docs/production.md). Copy to .env.production, which is
# git-ignored. Never commit real values. Generate every secret; use URL-safe characters only
# (the passwords end up inside connection URLs):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- public addresses (https, no trailing slash, no path) ---
APP_ORIGIN=
API_ORIGIN=

# --- secrets (all required) ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 48+ random characters; signs login tokens
JWT_SECRET_KEY=
# Required only if you connect Shopify. 32 random bytes, base64:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=

# --- AI providers: a real vendor (production refuses the fake provider) ---
# openai | openrouter | groq | together | deepseek | mistral | gemini | anthropic | custom_openai_compatible
# Embeddings need a 1536-wide model: see docs/ai-providers.md for who can serve them.
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# --- Shopify (leave blank to run without it) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# true = run without live updates instead of exposing a public webhook URL (API_ORIGIN is used otherwise)
SHOPIFY_WEBHOOKS_DISABLED=false

# --- WhatsApp (leave blank to run without it; see docs/whatsapp.md) ---
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Required once WHATSAPP_APP_ID is set, unless WHATSAPP_WEBHOOKS_DISABLED=true
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# true = run without a registered webhook (no inbound messages) instead of setting the token above
WHATSAPP_WEBHOOKS_DISABLED=false

# --- Email (leave blank to run without it; see docs/platform-admin.md, docs/operations-architecture.md) ---
# resend | fake (production refuses "fake")
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Real inbound-email domain; production refuses the *.invalid placeholder once email is configured
EMAIL_INBOUND_DOMAIN=
# Required once EMAIL_API_KEY is set, unless EMAIL_WEBHOOKS_DISABLED=true
EMAIL_WEBHOOK_SECRET=
EMAIL_WEBHOOKS_DISABLED=false

# --- Platform admin seed (optional; read only by tools/seed_platform_admin.py) ---
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- optional ---
# FORWARDED_ALLOW_IPS=172.28.0.0/24
# LOG_LEVEL=INFO

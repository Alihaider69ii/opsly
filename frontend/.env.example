# Server-side URL of the FastAPI backend (never exposed to the browser).
API_URL=http://localhost:8000

# PUBLIC values: the website chat widget runs in visitors' browsers and calls the API directly.
# Nothing secret belongs here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Shopify OAuth callback (/integrations/shopify/callback) is served by this Next.js app and
# forwards to the API server-side. No Shopify credential or token is ever needed here; the Shopify
# app's redirect URL must be {NEXT_PUBLIC_APP_URL}/integrations/shopify/callback (and the backend's
# SHOPIFY_REDIRECT_URI must match it).

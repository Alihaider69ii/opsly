# Backend settings. Copy to backend/.env (see also frontend/.env.example).
# Never commit real values.

# --- Database (matches docker-compose.yml defaults) ---
POSTGRES_USER=bizflow
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- Backend ---
# development | test | staging | production. Anything else is refused at start. "production" turns
# on the startup safety gate (docs/production.md): the API and the worker REFUSE to start with a weak
# secret, a wildcard/http CORS origin, the fake AI provider, a SQLite database, and so on.
ENVIRONMENT=
# Level for the application's own logs (DEBUG, INFO, WARNING, ERROR). INFO shows the chat/RAG/LLM events.
LOG_LEVEL=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=

# --- Authentication ---
# REQUIRED. Signs access tokens; the backend refuses to start without 32+ characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Access token lifetime in minutes (there are no refresh tokens yet)
ACCESS_TOKEN_EXPIRE_MINUTES=
# Attempts per client IP per window on /api/auth/login and /api/auth/register
AUTH_RATE_LIMIT_ATTEMPTS=
AUTH_RATE_LIMIT_WINDOW_SECONDS=
SHOPIFY_OAUTH_RATE_LIMIT=

# --- Reverse proxy / frontend server (read by uvicorn, not by the app) ---
# The Next.js server forwards each user's X-Forwarded-For so rate limiting sees real clients.
# uvicorn only honors it from these peers. Defaults to 127.0.0.1 (local dev); in Docker/prod set
# it to the frontend's address, never "*" unless the backend is unreachable except via that proxy.
# FORWARDED_ALLOW_IPS==
# Interactive API docs (/docs, /redoc, /openapi.json): on in development, OFF in production unless
# you set this to true.
# API_DOCS_ENABLED=
# Largest request body the API reads (bytes). Webhooks and the public chat have their own caps.
# MAX_REQUEST_BODY_BYTES=

# --- Database timeouts (PostgreSQL only; seconds) ---
# A stuck query or a contended row can never hold a connection for ever. The server cancels the
# statement / gives up the lock / ends an idle open transaction.
# DB_CONNECT_TIMEOUT_SECONDS=
# DB_STATEMENT_TIMEOUT_SECONDS=
# DB_LOCK_TIMEOUT_SECONDS=
# DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=

# --- Job queue (Redis from docker-compose) ---
REDIS_URL=
# Key prefix of the job queue and the worker heartbeats. Give each deployment sharing one Redis its own.
# REDIS_QUEUE_KEY=bizflow:queue:crawl
# The worker touches this file every few seconds; the container health check reads it
# (`python -m app.workers.healthcheck`). Default: /tmp/bizflow-worker-heartbeat
# WORKER_HEARTBEAT_FILE=

# --- AI providers (Phase 4: vendor-neutral; see docs/ai-providers.md) ---
# The language model and the embeddings are configured INDEPENDENTLY: you can answer with one
# vendor and embed with another. A provider id selects a row of the provider catalog:
#   openai, openrouter, groq, together, deepseek, mistral, gemini   (known OpenAI-compatible vendors)
#   custom_openai_compatible   (any OpenAI-style endpoint, e.g. a local gateway: set *_BASE_URL)
#   fake                       (deterministic, offline, NON-semantic: development and tests only;
#                               refused when ENVIRONMENT=production)
# Which vendors offer embeddings is in the catalog; openrouter, groq and deepseek are LLM-only.
# A blank *_MODEL / *_BASE_URL means "that provider's default". Model names are configuration.
# API keys are secrets: set them here or in the environment, never in code, never committed.
#
# Embeddings.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Must equal the database vector column size (1536). Changing it needs a migration and re-embed.
EMBEDDING_DIMENSIONS=
# Changing EMBEDDING_PROVIDER / EMBEDDING_MODEL / EMBEDDING_BASE_URL is safe: vectors from the old
# model are kept but ignored by search until a re-crawl re-embeds them (docs/ai-providers.md).
#
# Legacy: if LLM_API_KEY / EMBEDDING_API_KEY are blank, the "openai" provider falls back to this,
# so existing deployments that only set OPENAI_API_KEY keep working. Other providers ignore it.
OPENAI_API_KEY=

# --- Website crawler (defaults shown; all optional) ---
CRAWL_MAX_PAGES=
CRAWL_MAX_DEPTH=
CRAWL_MAX_RESPONSE_BYTES=
CRAWL_MAX_DOCUMENT_CHARS=
CRAWL_TOTAL_TIMEOUT_SECONDS
CRAWL_DELAY_SECONDS=
# Only these destination ports are ever contacted
CRAWL_ALLOWED_PORTS=
CRAWL_USER_AGENT=
CRAWL_MIN_INTERVAL_SECONDS=
KNOWLEDGE_MAX_SOURCES_PER_ORG=

# --- Chunking ---
CHUNK_SIZE=
CHUNK_OVERLAP=

# --- AI brain: language model ---
# Provider ids as in the AI providers section above.
LLM_PROVIDER=
# The model name lives here, never in code. Pick one your account can use (blank = provider default).
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Only if your endpoint differs from the provider's default: "max_tokens" or "max_completion_tokens".
# LLM_MAX_TOKENS_FIELD=
LLM_TIMEOUT_SECONDS=
LLM_MAX_OUTPUT_TOKENS=
# Leave unset to use the provider default
# LLM_TEMPERATURE=

# --- RAG and chat ---
# Chunks retrieved per question
RAG_TOP_K=
# Minimum cosine similarity for a chunk to count as relevant. Below it the assistant answers with
# the fallback message and the LLM is NOT called. Tune against real questions: with
# text-embedding-3 relevant matches score ~0.3-0.6, unrelated < 0.2. (The fake embedding provider is
# not semantic, so this threshold is only meaningful with EMBEDDING_PROVIDER=openai.)
RAG_SIMILARITY_THRESHOLD=
# Cap on knowledge text sent to the model per question
RAG_MAX_CONTEXT_CHARS=
# Previous messages included as conversation memory
CHAT_HISTORY_LIMIT=
CHAT_MAX_MESSAGE_CHARS=
CHAT_MAX_RESPONSE_CHARS=
CHAT_MAX_MESSAGES_PER_CONVERSATION=
# CHAT_FALLBACK_MESSAGE="I don't have enough information to answer that accurately. Could you share a little more about what you're looking for?"

# --- Public chat abuse protection ---
# Messages per client IP and public key per window
PUBLIC_CHAT_RATE_LIMIT=
PUBLIC_CHAT_RATE_WINDOW_SECONDS=
# New conversations per client IP and public key per hour
PUBLIC_CHAT_CONVERSATION_LIMIT=
PUBLIC_CHAT_MAX_BODY_BYTES=
# memory = per API process; redis = counters shared across workers (falls back to memory if Redis is down)
RATE_LIMIT_BACKEND=

# --- Secrets at rest (Phase 4) ---
# REQUIRED before any integration can be connected. AES-256-GCM key protecting stored Shopify
# tokens: 32 random bytes, base64. Generate one:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing this key makes stored tokens unreadable (merchants simply reconnect); leaking it with a
# database copy exposes them. Keep it in a secret manager in production.
SECRET_ENCRYPTION_KEY=
# Key rotation: deploy the NEW key as SECRET_ENCRYPTION_KEY with a new id, and list the old one
# ("id:key,id:key") so existing tokens still decrypt; they are re-encrypted under the new key the
# next time they refresh (within the hour for an active store).
# SECRET_ENCRYPTION_KEY_ID=
# SECRET_ENCRYPTION_PREVIOUS_KEYS=

# --- Shopify (Phase 4; see docs/shopify.md) ---
# Credentials of YOUR Shopify app (Dev Dashboard / Partner Dashboard). The client secret signs
# OAuth callbacks and webhooks and never leaves the server. Blank = the Shopify page shows
# "not configured" and nothing breaks.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Where Shopify sends the merchant after approval. Must exactly match a redirect URL registered for
# the app. It points at the Next.js frontend, which holds the user's session. https in production.
SHOPIFY_REDIRECT_URI=http://localhost:3000/integrations/shopify/callback
# Pinned Admin API version (quarterly: 2026-10, 2027-01, ...). Upgrade deliberately.
SHOPIFY_API_VERSION=2026-10
# Minimum read-only scopes. Documented in docs/shopify.md; change only with a reason.
SHOPIFY_SCOPES=read_products,read_customers,read_orders
# Public https base URL of THIS API, used to register webhooks (/api/webhooks/shopify). Leave blank
# on localhost: Shopify cannot reach it, so live updates stay off and the manual sync still works.
SHOPIFY_WEBHOOK_BASE_URL=
# Development only (refused in production): talk to a local fake Shopify instead of
# https://<shop>.myshopify.com. Shop domains are still validated as *.myshopify.com.
# SHOPIFY_DEV_BASE_URL=
# Tuning (defaults shown):
# SHOPIFY_SYNC_MIN_INTERVAL_SECONDS=
# SHOPIFY_SYNC_SLICE_SECONDS=
# SHOPIFY_MAX_RETRIES=
# SHOPIFY_WEBHOOK_RETENTION_DAYS=
# SHOPIFY_SYNC_STALE_AFTER_SECONDS=
# How often the worker verifies this app's webhook subscriptions still exist and re-creates missing
# ones (Shopify deletes API-created subscriptions after 8 failed deliveries), then runs a catch-up sync.
# SHOPIFY_WEBHOOK_AUDIT_INTERVAL_SECONDS=
# Production only: set true to run WITHOUT live updates (manual sync only) instead of configuring a
# public https SHOPIFY_WEBHOOK_BASE_URL. Production refuses to start with Shopify configured and
# neither of the two, so a missing webhook URL is a decision, not an accident.
# SHOPIFY_WEBHOOKS_DISABLED=

# --- WhatsApp (Phase 6-9; see docs/whatsapp.md) ---
# Credentials of YOUR Meta WhatsApp Business app. The app secret signs inbound webhook payloads
# and never leaves the server. Blank = the WhatsApp page shows "not configured" and nothing breaks.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Verifies Meta's webhook subscription handshake (challenge/response). Required once WHATSAPP_APP_ID
# is set, unless WHATSAPP_WEBHOOKS_DISABLED=true. Set this to the same value you enter in the Meta
# App dashboard's webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Pinned Graph API version.
WHATSAPP_API_VERSION=v26.0
# Only if your endpoint differs from Meta's default Graph API host.
# WHATSAPP_GRAPH_BASE_URL=
# "whatsapp_cloud" is the real provider; "fake" is deterministic/offline, development and tests
# only, refused when ENVIRONMENT=
WHATSAPP_MESSAGING_PROVIDER=whatsapp_cloud
# Production only: set true to run WITHOUT a configured webhook verify token (manual/no inbound
# messages) instead of registering a real webhook in the Meta dashboard.
# WHATSAPP_WEBHOOKS_DISABLED=f
# Tuning (defaults shown):
# WHATSAPP_WEBHOOK_MAX_BODY_BYTES=
# WHATSAPP_REQUEST_TIMEOUT_SECONDS=
# WHATSAPP_MAX_RETRIES=
# WHATSAPP_WEBHOOK_RETENTION_DAYS=
# WHATSAPP_SEND_RATE_LIMIT=
# WHATSAPP_SEND_RATE_WINDOW_SECONDS=
# WHATSAPP_CONNECT_RATE_LIMIT=
# WHATSAPP_TEMPLATE_SYNC_RATE_LIMIT=
# WHATSAPP_CUSTOMER_SERVICE_WINDOW_HOURS=
# WHATSAPP_AI_HISTORY_MAX_MESSAGES=
# WHATSAPP_AI_HISTORY_MAX_CHARS=
# WHATSAPP_AI_MAX_CONSECUTIVE_FALLBACKS=

# --- Email (Phase 9-10; see docs/whatsapp.md, docs/operations-architecture.md) ---
# openai-style provider id is not used here: this is the transactional/inbound email vendor.
# "resend" is the real provider; "fake" is deterministic/offline, development and tests only,
# refused when ENVIRONMENT=.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
# Only if your endpoint differs from the provider's default.
# EMAIL_BASE_URL=
# Real inbound-email domain (e.g. support.yourbrand.com). Production refuses to start with email
# configured while this is still the placeholder *.invalid domain.
EMAIL_INBOUND_DOMAIN=
# Verifies the provider's webhook signature (Svix-style HMAC). Required once EMAIL_API_KEY is set,
# unless EMAIL_WEBHOOKS_DISABLED=true. Set this to the signing secret the provider gives you.
EMAIL_WEBHOOK_SECRET=
# Production only: set true to run WITHOUT a configured webhook secret (outbound email only, no
# inbound/delivery-status processing) instead of registering a real webhook with the provider.
# EMAIL_WEBHOOKS_DISABLED=false
# Base URL used to build one-click unsubscribe links in marketing campaign sends. Required at
# send-time (not startup) once a marketing campaign is sent.
# EMAIL_UNSUBSCRIBE_BASE_URL=
# Tuning (defaults shown):
# EMAIL_REQUEST_TIMEOUT_SECONDS=
# EMAIL_MAX_RETRIES=
# EMAIL_WEBHOOK_MAX_BODY_BYTES=
# EMAIL_WEBHOOK_RETENTION_DAYS=
# EMAIL_SEND_RATE_LIMIT=120
# EMAIL_SEND_RATE_WINDOW_SECONDS=
# EMAIL_AI_HISTORY_MAX_MESSAGES=
# EMAIL_AI_HISTORY_MAX_CHARS=
# EMAIL_AI_MAX_CONSECUTIVE_FALLBACKS=
# EMAIL_CAMPAIGN_BATCH_SIZE=

# --- Platform admin (Phase 10; see docs/platform-admin.md) ---
# Seed-only: read exclusively by `python -m tools.seed_platform_admin`, never by request handling.
# Leave blank in development; the seed tool also accepts --email/--password overrides.
PLATFORM_ADMIN_EMAIL=
# If set, must pass the same strength check as JWT_SECRET_KEY (12+ distinct characters, no
# "changeme"/"placeholder"/"example"-style word) before the seed tool will accept it in production.
PLATFORM_ADMIN_PASSWORD=
